# ============================================================
# BankAI Environment Variables
# Copy this file to .env and fill in your values:
#   cp infra/.env.example .env
# ============================================================

# --- PostgreSQL ---
# Database credentials for the application and the postgres container
POSTGRES_USER=bankai
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=bankai

# --- Redis ---
# Redis connection URL (broker and result backend for Celery)
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
# Qdrant vector database URL and optional API key
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- JWT Security ---
# Secret key for signing JWT tokens — generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production

# --- Admin Account ---
# Admin email used for initial login
ADMIN_EMAIL=admin@bankai.local
# Admin password hash (bcrypt). Generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=

# --- LLM Provider API Keys ---
# Uncomment and set keys for the providers you intend to use.
# See backend/config/llm_providers.yaml for available models per provider.

# Local LM Studio (default base_url: http://host.docker.internal:1234/v1)
LM_STUDIO_API_KEY=lm-studio

# vLLM OpenAI-compatible server (BankAI FastAPI already uses :8000 — run vLLM on :8001)
VLLM_API_KEY=

# SGLang (default http://host.docker.internal:30000/v1)
SGLANG_API_KEY=

# Strata (default http://host.docker.internal:8080/v1 — required if Strata set API_KEY)
STRATA_API_KEY=

# Grafana GPU/CPU dashboard (infra/monitoring, host port 3001)
GRAFANA_URL=http://localhost:3001

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# --- Embedding Model ---
# Hugging Face model name used for document embeddings and RAG
EMBEDDING_MODEL=intfloat/multilingual-e5-small
